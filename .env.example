# Certification member IDs and HMAC secrets. Store as a hosting secret, never
# in source control. Production uses member PKI/mTLS and a dedicated network.
CERTIFICATION_GATEWAY_KEYS={}

# Required for AES-256-GCM encryption of each user's broker credentials and
# cached broker token. Generate a dedicated random value for every deployment.
CREDENTIAL_ENCRYPTION_KEY=

# Master switch. Leave false during development. Even when true, each user must
# separately acknowledge risk, release the kill switch and confirm every order.
LIVE_TRADING_ENABLED=false

# Independent deployment boundary. Keep the certification defaults until the
# venue, participant and legal approvals are complete.
TRADING_ENVIRONMENT=member_certification
LIVE_MARKET_ENABLED=false

# Set true only after the production runtime has a stable outbound IP and that
# IP is registered with every broker. Both switches are required to send orders.
LIVE_TRADING_EGRESS_READY=false

# Comma-separated authenticated user IDs that may change venue-wide operating
# state. Never grant this role automatically to the first public user.
OPERATOR_USER_IDS=
