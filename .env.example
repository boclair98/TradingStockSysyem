# Certification member IDs and HMAC secrets. Store as a hosting secret, never
# in source control. Production uses member PKI/mTLS and a dedicated network.
CERTIFICATION_GATEWAY_KEYS={}

# Required for AES-256-GCM encryption of each user's broker credentials and
# cached broker token. Generate a dedicated random value for every deployment.
CREDENTIAL_ENCRYPTION_KEY=

# Master switch. Leave false during development. Even when true, each user must
# separately acknowledge risk, release the kill switch and confirm every order.
LIVE_TRADING_ENABLED=false
